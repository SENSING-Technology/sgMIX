{
  // S56 双目模组：2x VB1940，RAW10，走 ISP0 硬件 ISP（标定 H06180102.txt，pinhole）
  "name": "s56",
  "description": "S56 双目模组（2x VB1940，RAW10，走 ISP0 硬件 ISP）",

  // 输出路径：isp = RAW 模组走 ISP0 硬件 ISP → NV12 → VIC → BGR
  "output": "isp",

  // 平台查询 json（相对 SDK 根目录）与其中 SensorSystemConfig 的名称
  "sipl_json": "sipl/s56.json",
  "sipl_config": "S56_2CH",

  // 传感器原生采集分辨率与帧率
  "capture_width": 2560,
  "capture_height": 1984,
  "fps": 30,

  // 期望的标定模型类型（仅提示性校验）：fisheye / pinhole
  // 本机标定 H06180102.txt 为 pinhole（8 系数 rational）
  "calib_type": "pinhole",

  // pipeline0/1 与标定文件左/右目的对应关系（由模组内部 GMSL 接线决定）：
  // 与 s56c 同模组族，暂按 true（pipeline0=物理右目）处理，实机验证时若深度异常
  // （大面积近距饱和/闪烁），改为 false 即可（运行时加载，无需重编译）
  "swap_lr": true,

  // GMSL 端口名 → link 掩码 [Transport0(AB), Transport1(CD)]
  // cam0=[0x0000,0x0001] cam1=[0x0000,0x0002] cam2=[0x0000,0x0100] cam3=[0x0000,0x0200]
  // cam4=[0x0001,0x0000] cam5=[0x0002,0x0000] cam6=[0x0100,0x0000] cam7=[0x0200,0x0000]
  "ports": {
    "cam0": ["0x0000", "0x0001"],
    "cam1": ["0x0000", "0x0002"],
    "cam2": ["0x0000", "0x0100"],
    "cam3": ["0x0000", "0x0200"],
    "cam4": ["0x0001", "0x0000"],
    "cam5": ["0x0002", "0x0000"],
    "cam6": ["0x0100", "0x0000"],
    "cam7": ["0x0200", "0x0000"]
  }
}
